# Shared local OCR settings. Copy to .env for the PowerShell scripts, or export
# the same names in the shell that starts DeepSeek Harness and the OCR service.
OCR_SERVICE_URL=http://127.0.0.1:8765
OCR_SERVICE_TOKEN=
OCR_LANGUAGE=ch
OCR_USE_GPU=false
# PaddleOCR 3 public model downloads stay below this local directory.
OCR_MODEL_CACHE_DIR=D:\Program Files\local model\paddleocr
OCR_MAX_FILE_MB=15
OCR_TIMEOUT_SECONDS=90
OCR_MIN_CONFIDENCE=0.50
OCR_MAX_CONCURRENCY=1
OCR_QUEUE_TIMEOUT_SECONDS=5

# Additional security bounds used by the service and plugin.
OCR_MAX_IMAGE_EDGE=12000
OCR_MAX_PIXELS=40000000
OCR_ALLOWED_DIRECTORIES=

# Optional fallback location for Node.js and pnpm used to launch Harness.
# Leave empty when they are already on PATH.
HARNESS_RUNTIME_DIR=D:\\Program Files\\deepseek-harness\\runtime
